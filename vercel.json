{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/gateway.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/tools-api/api/ampreset",
      "destination": "/api/gateway?_svc=nexadev&_targetPath=api/ampreset/"
    },
    {
      "source": "/tools-api/api/ampreset/",
      "destination": "/api/gateway?_svc=nexadev&_targetPath=api/ampreset/"
    },
    {
      "source": "/api/tikwm",
      "destination": "/api/gateway?_svc=tikwm"
    },
    {
      "source": "/api/spotify",
      "destination": "/api/gateway?_svc=spotify"
    },
    {
      "source": "/api/lyrics",
      "destination": "/api/gateway?_svc=lyrics"
    },
    {
      "source": "/api/chat",
      "destination": "/api/gateway?_svc=chat"
    },
    {
      "source": "/cleanuri",
      "destination": "/api/gateway?_svc=cleanuri"
    },
    {
      "source": "/clooud",
      "destination": "/api/gateway?_svc=clooud"
    },
    {
      "source": "/clooud/:path*",
      "destination": "/api/gateway?_svc=clooud"
    },
    {
      "source": "/api/nexadev/:path*",
      "destination": "/api/gateway?_svc=api-nexadev&_targetPath=:path*"
    },
    {
      "source": "/media-api/:path*",
      "destination": "/api/gateway?_svc=api-nexadev&_targetPath=:path*"
    },
    {
      "source": "/nexadev/:path*",
      "destination": "/api/gateway?_svc=nexadev&_targetPath=:path*"
    },
    {
      "source": "/tools-api/:path*",
      "destination": "/api/gateway?_svc=nexadev&_targetPath=:path*"
    },
    {
      "source": "/anime-api/:path*",
      "destination": "/api/gateway?_svc=apii&_targetPath=:path*"
    },
    {
      "source": "/apii/:path*",
      "destination": "/api/gateway?_svc=apii&_targetPath=:path*"
    },
    {
      "source": "/zapi-api/:path*",
      "destination": "/api/gateway?_svc=zapi&_targetPath=:path*"
    },
    {
      "source": "/zapi-file/:path*",
      "destination": "/api/gateway?_svc=zapi-file&_targetPath=:path*"
    },
    {
      "source": "/image-api/:path*",
      "destination": "https://clooud.my.id/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
